# Slack Configuration
SLACK_BOT_TOKEN="xoxb-1..."
SLACK_APP_TOKEN="xapp..."
GROQ_API_KEY=your-groq-api-key-here

# Google Drive Service Account Configuration
# Path to your service account key JSON file
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service-account-key.json

# Optional: Specific folder ID to limit access to a Drive folder
# Leave empty to access all shared files
GOOGLE_DRIVE_FOLDER_ID=

# Optional GitHub integration for contributor-based recommendations
# GitHub personal access token recommended to avoid low unauthenticated rate limits
GITHUB_TOKEN=
# Default repo to sync with /sync-repo if no owner/repo is passed
GITHUB_REPO=
# Optional cap for recent commit history pulled during a sync
GITHUB_SYNC_COMMIT_LIMIT=30

#Optional: Set to url if not using a local database
SQL_DATABASE_URL=
