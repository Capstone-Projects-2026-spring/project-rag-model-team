# Slack Configuration
SLACK_BOT_TOKEN="xoxb-1..."
SLACK_APP_TOKEN="xapp..."
GROQ_API_KEY=your-groq-api-key-here

# Microsoft OneDrive / Graph API Configuration
# Register your app at https://portal.azure.com to get these credentials
MICROSOFT_CLIENT_ID=your_client_id_here
MICROSOFT_CLIENT_SECRET=your_client_secret_here
MICROSOFT_REDIRECT_URI=http://localhost:3001/auth/callback

# Optional: Specific OneDrive folder ID to limit access to a specific folder
# Leave empty to access all files in the user's OneDrive
ONEDRIVE_FOLDER_ID=

# Optional GitHub integration for contributor-based recommendations
# GitHub personal access token recommended to avoid low unauthenticated rate limits
GITHUB_TOKEN=
# Default repo to sync with /sync-repo if no owner/repo is passed
GITHUB_REPO=
# Optional cap for recent commit history pulled during a sync
GITHUB_SYNC_COMMIT_LIMIT=30

#Optional: Set to url if not using a local database
SQL_DATABASE_URL=
